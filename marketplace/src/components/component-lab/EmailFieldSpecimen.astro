<article class="lab-tile lab-input-tile" id="lab-input" aria-labelledby="lab-input-title">
  <div class="lab-tile-top">
    <span class="lab-ref"><b>02</b> FIELD / VALIDATED</span>
    <span class="lab-state lab-state-idle" id="lab-email-state"><i aria-hidden="true"></i> WAITING</span>
  </div>
  <form class="lab-tile-body" id="lab-email-form" novalidate>
    <div class="lab-glyph lab-glyph-input" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3.5" y="5.5" width="17" height="13" rx="2" />
        <path d="m4.5 7 7.5 6 7.5-6" />
      </svg>
    </div>
    <h3 id="lab-input-title">Email field</h3>
    <label for="lab-email">Address</label>
    <p class="lab-field-hint" id="lab-email-hint">Validation is local. No message will be sent.</p>
    <input id="lab-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" aria-describedby="lab-email-hint lab-email-error" required />
    <p class="lab-error" id="lab-email-error"></p>
    <button class="lab-button lab-button-secondary" type="submit">Check address
      <svg aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M8 3l5 5-5 5" /></svg>
    </button>
    <p class="lab-status" id="lab-email-status" role="status" aria-live="polite"></p>
  </form>
  <div class="lab-tile-foot"><span>VISIBLE LABEL</span><span>INLINE RECOVERY</span></div>
</article>

<script>
  const emailSpecimens = document.querySelectorAll<HTMLElement>("#lab-input");

  emailSpecimens.forEach((specimen) => {
    const emailForm = specimen.querySelector<HTMLFormElement>("#lab-email-form");
    const emailInput = specimen.querySelector<HTMLInputElement>("#lab-email");
    const emailError = specimen.querySelector<HTMLElement>("#lab-email-error");
    const emailStatus = specimen.querySelector<HTMLElement>("#lab-email-status");
    const emailState = specimen.querySelector<HTMLElement>("#lab-email-state");

    const setEmailState = (state: "waiting" | "invalid" | "ready" | "valid") => {
      if (!emailState) return;
      emailState.classList.remove("lab-state-idle", "lab-state-error", "lab-state-success");
      if (state === "waiting") emailState.classList.add("lab-state-idle");
      if (state === "invalid") emailState.classList.add("lab-state-error");
      if (state === "valid") emailState.classList.add("lab-state-success");
      emailState.lastChild!.textContent = state.toUpperCase();
    };

    emailForm?.addEventListener("submit", (event) => {
      event.preventDefault();
      if (!emailInput || !emailError || !emailStatus) return;
      emailStatus.textContent = "";

      if (!emailInput.validity.valid) {
        emailInput.setAttribute("aria-invalid", "true");
        emailInput.classList.remove("lab-shake");
        void emailInput.offsetWidth;
        emailInput.classList.add("lab-shake");
        emailError.textContent = emailInput.value.trim()
          ? "Use an address like name@example.com."
          : "Enter an email address to continue.";
        setEmailState("invalid");
        emailInput.focus();
        return;
      }

      emailInput.removeAttribute("aria-invalid");
      emailError.textContent = "";
      setEmailState("valid");
      emailStatus.textContent = "Address looks valid. Nothing was sent or stored.";
    });

    emailInput?.addEventListener("input", () => {
      emailInput.classList.remove("lab-shake");
      if (emailInput.validity.valid) {
        emailInput.removeAttribute("aria-invalid");
        if (emailError) emailError.textContent = "";
        if (emailInput.value.trim()) setEmailState("ready");
        if (emailStatus) emailStatus.textContent = "";
      } else if (emailInput.getAttribute("aria-invalid") === "true") {
        setEmailState("invalid");
        if (emailError) {
          emailError.textContent = emailInput.value.trim()
            ? "Use an address like name@example.com."
            : "Enter an email address to continue.";
        }
      }
    });
  });
</script>
