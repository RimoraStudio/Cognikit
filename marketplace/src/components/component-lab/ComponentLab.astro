---
import ActionSpecimen from "./ActionSpecimen.astro";
import DialogSpecimen from "./DialogSpecimen.astro";
import EmailFieldSpecimen from "./EmailFieldSpecimen.astro";
---

<section class="component-lab" id="component-lab" aria-labelledby="component-lab-title">
  <div class="lab-heading">
    <div>
      <p class="lab-kicker"><span class="lab-live-dot" aria-hidden="true"></span> INTERACTIVE LAB <span class="lab-kicker-code">RC / 01—03</span></p>
      <h2 id="component-lab-title">A component is its states.</h2>
      <p class="lab-intro">Three live patterns. Try the action, validate the field, and inspect the dialog behavior.</p>
    </div>
    <svg class="lab-signal-map" viewBox="0 0 196 72" aria-hidden="true">
      <path d="M8 36h42l15-15h30l14 15h34l14-15h31" />
      <path d="M50 36v24h37m22-24v-20h30" />
      <circle cx="8" cy="36" r="4" /><circle cx="50" cy="36" r="4" /><circle cx="95" cy="21" r="4" />
      <circle cx="109" cy="36" r="4" /><circle cx="157" cy="36" r="4" /><circle cx="188" cy="21" r="4" />
      <circle cx="87" cy="60" r="4" /><circle cx="139" cy="16" r="4" />
    </svg>
  </div>

  <div class="lab-track" aria-hidden="true">
    <span class="lab-track-node"><b>01</b> ACTION</span>
    <i></i>
    <span class="lab-track-node"><b>02</b> INPUT</span>
    <i></i>
    <span class="lab-track-node"><b>03</b> DIALOG</span>
    <span class="lab-track-note">KEYBOARD + POINTER</span>
  </div>

  <div class="lab-grid">
    <ActionSpecimen />
    <EmailFieldSpecimen />
    <DialogSpecimen />
  </div>

  <span class="lab-corner lab-corner-tl" aria-hidden="true"></span>
  <span class="lab-corner lab-corner-br" aria-hidden="true"></span>
</section>
